# ==============================================================================
# VideoForge Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# All variables are optional; sensible defaults are automatically detected.
# ==============================================================================

# --- FFmpeg & Media Processing ---
# Path to ffmpeg executable (if not in system PATH or bundled directories)
# Windows example: FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# POSIX example:   FFMPEG_PATH=/usr/bin/ffmpeg
# FFMPEG_PATH=

# Path to ffprobe executable (if not next to ffmpeg or in system PATH)
# FFPROBE_PATH=

# --- Application Storage & Paths ---
# Directory for application database (videoforge.db) and runtime logs
# Defaults:
#   Windows: %APPDATA%\VideoForge
#   macOS:   ~/Library/Application Support/VideoForge
#   Linux:   ~/.local/share/videoforge
# VIDEOFORGE_DATA_DIR=

# Explicit path to settings.json (defaults to <VIDEOFORGE_DATA_DIR>/settings.json or ./settings.json)
# VIDEOFORGE_SETTINGS_PATH=

# Explicit path to master presets registry JSON
# Defaults to bundled presets/master_presets_registry.json in the repository
# MASTER_PRESETS_REGISTRY_PATH=

# --- Logging & Diagnostics ---
# Enable verbose debug logging to console and log files (0, 1, true, false)
# VF_DEBUG=0

# --- Display & UI ---
# Qt scaling factor rounding policy (PassThrough, Round, Floor, Ceil)
QT_SCALE_FACTOR_ROUNDING_POLICY=PassThrough

# --- Testing & Development ---
# Optional path to real content automation directory for extended integration tests
# GENERATED_CONTENT_DIR=
